{
  "kind": "collectionType",
  "collectionName": "commandes",
  "info": {
    "singularName": "commande",
    "pluralName": "commandes",
    "displayName": "Commande",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "failed",
        "cancelled"
      ],
      "default": "pending",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "eur",
      "required": true
    },
    "subtotal": {
      "type": "decimal",
      "min": 0,
      "default": 0,
      "required": true
    },
    "shippingAmount": {
      "type": "decimal",
      "min": 0,
      "default": 0,
      "required": true
    },
    "total": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "lineItems": {
      "type": "json",
      "required": true
    },
    "customerEmail": {
      "type": "email",
      "private": true
    },
    "shippingAddress": {
      "type": "json",
      "private": true
    },
    "paymentSimulationStartedAt": {
      "type": "datetime",
      "private": true
    },
    "trackingStatus": {
      "type": "enumeration",
      "enum": [
        "awaiting_payment",
        "payment_confirmed",
        "preparing",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "awaiting_payment",
      "required": true
    },
    "trackingCarrier": {
      "type": "string"
    },
    "trackingNumber": {
      "type": "string"
    },
    "trackingUpdatedAt": {
      "type": "datetime"
    },
    "paidAt": {
      "type": "datetime"
    },
    "shippedAt": {
      "type": "datetime"
    },
    "deliveredAt": {
      "type": "datetime"
    },
    "trackingEvents": {
      "type": "json",
      "default": []
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "commandes"
    }
  }
}
